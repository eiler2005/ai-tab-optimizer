# =============================================================================
# AITab — Environment configuration
# =============================================================================
# Copy this file to `.env` and adjust as needed. The repo's `.gitignore` excludes
# all `.env*` files so your local values are never committed.
#
# This project keeps its config surface intentionally small: the FastAPI server
# reads almost all settings from SQLite (`app_settings` table) at runtime, which
# the extension manages through Settings → AI Provider. Server startup consumes PORT; the security middleware also reads
# LOCAL_API_KEY and AITAB_EXTENSION_ORIGINS.
# =============================================================================

# ---- Server ------------------------------------------------------------------
# Port the FastAPI / uvicorn server binds to. The Chrome extension defaults to
# http://localhost:8765 — change both if you need a non-default port.
PORT=8765


# =============================================================================
# Reference: settings managed via the extension (NOT environment variables)
# =============================================================================
# These are persisted server-side in `tab_analysis.db → app_settings` and edited
# from the extension Settings view. Listed here so contributors know where they
# live; do NOT add them to your shell environment.
#
#   serverAiProvider     = claude_code | codex_cli | none   (primary CLI)
#   fallbackAiProvider   = claude_code | codex_cli | none   (fallback CLI)
#   claudeCliPath        = absolute path to `claude` binary (optional override)
#   codexCliPath         = absolute path to `codex` binary  (optional override)
#   codexModel           = model name passed to Codex CLI, e.g. gpt-5.6-terra
#   localServerUrl       = http://localhost:8765            (extension-side)
#   obsidianVaultPath    = filesystem path the extension writes notes to
#   protectedDomains     = comma/array of domains excluded from automatic cleanup
#   staleDaysThreshold   = integer (days) for the stale-tab heuristic
#   autoSnapshotEnabled  = boolean
#   autoSnapshotIntervalHours = integer
#   historyRetentionDays = integer (7..90)
#   maxStoredSnapshots   = integer
#
# Authentication for the underlying CLIs is handled by those CLIs themselves
# (e.g. `claude login`, `codex login`); this project never reads or stores their
# credentials.

# Optional API authentication (export these variables before starting the server).
# LOCAL_API_KEY=choose-a-local-token
# AITAB_EXTENSION_ORIGINS=chrome-extension://your-extension-id
